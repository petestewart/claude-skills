# Self-contained local server for the pr-walkthrough skill (follow-up chat +
# GitHub "Viewed" sync). Bound to 127.0.0.1:17799.
#
# Install:
#   cp com.trunktools.pr-walkthrough-server.plist ~/Library/LaunchAgents/
#   sed -i '' "s#__HOME__#$HOME#; s/__UID__/$(id -u)/" ~/Library/LaunchAgents/com.trunktools.pr-walkthrough-server.plist
#   launchctl load ~/Library/LaunchAgents/com.trunktools.pr-walkthrough-server.plist
# Or run manually: ~/.claude/skills/pr-walkthrough/server-run.sh
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trunktools.pr-walkthrough-server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.claude/skills/pr-walkthrough/server-run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/.claude/skills/pr-walkthrough</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.claude/skills/pr-walkthrough/server.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.claude/skills/pr-walkthrough/server.err.log</string>

  <key>UserID</key>
  <integer>__UID__</integer>
</dict>
</plist>